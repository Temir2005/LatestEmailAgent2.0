# Скопируйте этот файл в .env и впишите свой ключ.
# Bun подхватывает .env сам — ничего запускать не нужно.

# Бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Понадобится, когда появится ключ Claude. Тогда: LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Какой провайдер использовать: gemini (по умолчанию) или anthropic
LLM_PROVIDER=gemini

# Живой ящик по IMAP (необязательно).
# Для Gmail нужен пароль приложения: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Отправка из чата. Для Gmail эти значения подходят по умолчанию;
# используется тот же EMAIL_ADDRESS и пароль приложения.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# База. Именно CLINIC_DATABASE_URL, а не DATABASE_URL: последняя часто
# экспортирована глобально под другой проект и увела бы переписку не туда.
# Внутри docker compose подставляется автоматически.
CLINIC_DATABASE_URL=postgres://clinic:clinic@localhost:5434/clinic

# Веб-интерфейс: localhost:3001 (и при локальном запуске, и через Docker).
PORT=3001
WEB_PORT=3001
